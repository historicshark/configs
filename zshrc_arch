# Lines configured by zsh-newuser-install
HISTFILE=~/.histfile
HISTSIZE=1000
SAVEHIST=1000
setopt autocd extendedglob nomatch
unsetopt beep
bindkey -v
# End of lines configured by zsh-newuser-install
# The following lines were added by compinstall
zstyle :compinstall filename '/home/historicshark/.zshrc'

autoload -Uz compinit
compinit
# End of lines added by compinstall

fpath=(/home/historicshark/.config/zsh/ $fpath)
autoload -Uz prompt_purification_setup;
prompt_purification_setup

setopt AUTO_MENU
setopt MENU_COMPLETE
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' format '%F{cyan}%d%f'

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init - zsh)"
eval "$(pyenv virtualenv-init -)"

bindkey "\e[A" history-beginning-search-backward
bindkey "\e[B" history-beginning-search-forward

# The most important aliases ever (the only thing I borrowed from OMZ)
alias ls='ls --color=auto'
alias l='ls -lah'
alias la='ls -lAh'
alias ll='ls -lh'
alias lsa='ls -lah'

# colors
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ip='ip --color=auto'

# Set up fzf key bindings and fuzzy completion
source <(fzf --zsh)
bindkey -r '^T'
bindkey '^F' fzf-file-widget

# because less doesn't work in kitty
export MANPAGER='vim -M +MANPAGER -'

function weather() {
    curl "wttr.in/${1}?u"
}
